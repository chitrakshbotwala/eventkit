# /opt/eventkit/apps/server/.env on the VPS (chmod 600, owned by eventkit).
NODE_ENV=production
HOST=127.0.0.1
PORT=8080
PUBLIC_BASE_URL=https://event.example.org
TRUST_PROXY=true
DATABASE_URL=file:/var/lib/eventkit/eventkit.db
DATA_DIR=/var/lib/eventkit/data

EVENT_SLUG=flutter-event
EVENT_NAME=Flutter Build Day
EVENT_TIMEZONE=Asia/Kolkata

# From `node scripts/gen-keys.mjs --print` (keep secret; the public half goes into the desktop build).
MANIFEST_SIGNING_KEY=
MIN_APP_VERSION=0.1.0

# Google OAuth client ("Web application"), redirect URI https://event.example.org/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CONTACT_HINT=Not on the list? Ask at the help desk.

# First superadmin (created by the seed); change the password after the first login.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Optional: higher GitHub API rate limit for the manifest resolver.
GITHUB_TOKEN=
