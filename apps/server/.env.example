# Copy to .env (pnpm bootstrap does this and generates keys for you).
NODE_ENV=development
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
# Vite admin dev server
ADMIN_ORIGINS=http://localhost:5173
DATABASE_URL=file:./dev.db
DATA_DIR=./data

EVENT_SLUG=flutter-event
EVENT_NAME=Flutter Build Day
EVENT_TIMEZONE=Asia/Kolkata

# base64 Ed25519 secret key (pnpm keys:gen). Required in production.
MANIFEST_SIGNING_KEY=
# Serve placeholder artifacts (only installable with --simulate) until the manifest is resolved.
MANIFEST_ALLOW_PLACEHOLDER=true
MIN_APP_VERSION=0.1.0

# Attendee sign-in: Google OAuth client of type "Web application" (required in production).
# Authorized redirect URI: <PUBLIC_BASE_URL>/auth/google/callback
# When unset in development, a local test page that accepts any email stands in for Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CONTACT_HINT=Not on the list? Contact the organizers at the help desk.

# First superadmin, created by the seed script
SUPERADMIN_EMAIL=admin@example.org
SUPERADMIN_PASSWORD=change-me-please-now

# Optional: raises GitHub API rate limit for the manifest resolver
GITHUB_TOKEN=
