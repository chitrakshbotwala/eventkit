{
  "name": "@eventkit/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:pg": "node scripts/make-postgres-schema.mjs",
    "admin:create": "tsx scripts/create-admin.ts",
    "manifest:resolve": "tsx scripts/resolve-manifest.ts",
    "mirror:sync": "tsx scripts/mirror-sync.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@eventkit/shared": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "csv-parse": "^6.2.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.3.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prisma": "^6.19.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
